[Unit]
Description=herdr-bridge: reach herdr agents from other devices and apps
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-bridge
Restart=always
RestartSec=3
Environment=RUST_LOG=herdr_bridge=info,tower_http=info
# This machine only: `tailscale serve` brings the tailnet here. `systemctl --user edit herdr-bridge` can set 0.0.0.0.
Environment=HERDR_BRIDGE_BIND=127.0.0.1
# The bridge runs `herdr` and `git`; a user unit's default PATH misses user installs.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
